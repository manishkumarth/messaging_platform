# Copy to .env and adjust. Placeholder values only.
PORT=3000

# SQLite file (created on first start). Use a path on a persistent volume in production.
DATABASE_PATH=./data/app.db

# Shared secret the provider sends in the x-webhook-secret header.
# Leave empty to disable the check (local experiments only).
WEBHOOK_SECRET=replace-with-a-long-random-string

# debug | info | warn | error | silent
LOG_LEVEL=info

# Maximum characters allowed in a message body
MAX_TEXT_LENGTH=4096
